{
  "name": "vanta-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "check": "npm run security && npm test && npm run build",
    "security": "node scripts/security-check.mjs",
    "e2e": "playwright test",
    "prepare:stockfish": "node scripts/prepare-stockfish.mjs",
    "predev": "npm run prepare:runtime",
    "prebuild": "npm run prepare:runtime",
    "presecurity": "npm run prepare:runtime",
    "pretest": "npm run prepare:runtime",
    "prepare:runtime": "npm run prepare:stockfish"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
